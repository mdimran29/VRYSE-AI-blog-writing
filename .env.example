# Copy to .env.local and fill in. Never commit .env.local.

# Vercel AI Gateway key (Vercel dashboard → AI Gateway → API Keys)
AI_GATEWAY_API_KEY=

# Models per stage, as "provider/model" strings.
# Prefixes: none = AI Gateway · google-direct/ = Gemini API free tier · ollama/ = local
VRYSE_ANALYSIS_MODEL=google/gemini-2.5-flash-lite
# The gateway free tier blocks Claude and the newest Gemini models. Try openai/gpt-5 or openai/gpt-4.1 for the final demo.
VRYSE_WRITER_MODEL=openai/gpt-5-mini
VRYSE_JUDGE_MODEL=google/gemini-2.5-flash
# Judge settings chosen in Step 8 (thinking off: σ 4.6 → 1.6). Use 1 run while developing; set 3 for the demo (threshold 3 points).
VRYSE_JUDGE_THINKING_BUDGET=0
VRYSE_JUDGE_RUNS=3

# Max parallel LLM calls (set 1 on strict free tiers)
VRYSE_LLM_CONCURRENCY=6
# Reuse identical LLM responses during development
VRYSE_DEV_CACHE=true

VRYSE_EMBED_MODEL=Xenova/bge-small-en-v1.5
VRYSE_DATA_DIR=./data
VRYSE_DB_PATH=./data/vryse.db

# Only for google-direct/ models
GOOGLE_GENERATIVE_AI_API_KEY=
# Only for ollama/ models
OLLAMA_BASE_URL=http://localhost:11434

# Only for automatic ingestion from the client sheet (README §4, option A)
CLIENT_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Hard spending cap (USD): no new AI calls once the logged total reaches it
VRYSE_BUDGET_USD=3
