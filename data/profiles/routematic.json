  "guide": {
    "summary": "Routematic blog posts speak directly to transport, HR and operations decision‑makers in Indian enterprises: start from a concrete operational problem, show evidence (external data + case results), explain practical options, end with a concise conclusion and an FAQ. Writers should follow the site's structure, tone and terminology so their pieces read like Routematic's own — evidence-first, prescriptive, plain language, and utility-focused.",
    "audience": "HR, transport/operations, procurement and finance managers at mid‑to‑large enterprises (including GCCs, IT/BPO, BFSI) responsible for employee transportation, safety and compliance in India.",
    "voice": {
      "tone": [
        "practical",
        "authoritative",
        "informative",
        "data-driven"
      ],
      "formality": "Professional and direct — business‑to‑business, not academic; a mild conversational address to the reader (you) is acceptable.",
      "pointOfView": "Address the reader as 'you' (or 'your') for recommendations; refer to Routematic and vendors in the third person (use 'we' sparingly, only for product or company statements in company-authored pieces).",
      "personality": "Decisive and prescriptive: statements are backed by a cited fact or a client result, recommendations are concrete and operational (steps, checklists, vendor criteria). Avoid marketing hyperbole; sound like an experienced operations partner."
    },
    "structure": {
      "typicalOutline": [
        "Intro (pain, statistic or regulation → what this article will cover)",
        "Key takeaways (optional, placed immediately after the intro when used)",
        "Main body: numbered/keyword-led H2 sections (each H2 ≈ a single problem → solution chunk; optional H3 subpoints)",
        "Conclusion heading (present in ~34/54 articles; when used place it before the FAQ)",
        "FAQ (present in 54/54 articles; almost always the final section)"
      ],
      "introPatterns": [
        {
          "pattern": "reader pain point → statistic → what this article covers",
          "articles": 22,
          "example": "Open with the operational pain, add a supporting statistic, then state what the article covers."
        },
        {
          "pattern": "reader pain point → what this article covers",
          "articles": 7,
          "example": "Start by naming the pain then say what you will explain or solve."
        },
        {
          "pattern": "reader pain point → definition → what this article covers",
          "articles": 3,
          "example": "State the pain, define the concept (e.g. 'TaaS' or 'OSH Code') and outline the article."
        },
        {
          "pattern": "statistic → reader pain point → what this article covers",
          "articles": 3,
          "example": "Lead with a striking statistic, then explain the pain it reveals and what you'll cover."
        },
        {
          "pattern": "other (unique) intro variants",
          "articles": 19,
          "example": "Variants include legal‑requirement opens, product‑centric leads, question opens and mixes of trends → problem → scope (each used once across the corpus)."
        }
      ],
